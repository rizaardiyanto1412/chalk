{
  "name": "chalk",
  "productName": "Chalk",
  "version": "0.1.0",
  "description": "Canvas design tool with a built-in browser, a Claude Code agent, and an MCP server",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "e2e": "node scripts/e2e.mjs",
    "install-app": "npm run dist && codesign --force --deep --sign - dist/mac-arm64/Chalk.app && rm -rf /Applications/Chalk.app && cp -R dist/mac-arm64/Chalk.app /Applications/Chalk.app",
    "test:connect": "node scripts/connect-agents-test.mjs"
  },
  "build": {
    "appId": "dev.chalk.app",
    "productName": "Chalk",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/browser": "^4.3.3",
    "parse5": "^8.0.1",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "author": "Riza Maulana Ardiyanto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizaardiyanto1412/chalk.git"
  }
}
